{
  "extends": "astro/tsconfigs/strictest",
  "exclude": ["node_modules", "public", "dist"],
  "compilerOptions": {
    "lib": ["ESNext"],
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@data/*": ["data/*"],
      "@integrations/*": ["src/integrations/*"],
      "@layouts/*": ["src/layouts/*"],
      "@utils/*": ["src/utils/*"]
    }
  }
}
