---
interface Props {
	readonly title?: string;
	readonly description?: string;
	readonly buttonText?: string;
	readonly className?: string;
}

const {
	title = "Subscribe to my newsletter",
	description = "Get notified when I publish new posts and updates.",
	buttonText = "Subscribe",
	className = "",
} = Astro.props;

const buttondownUsername = import.meta.env.BUTTONDOWN_USERNAME;
const formAction = `https://buttondown.com/api/emails/embed-subscribe/${buttondownUsername}`;
---

<div class={`newsletter-signup ${className}`}>
	<h3>{title}</h3>
	<p>{description}</p>

	<form method="POST" action={formAction}>
		<label for="newsletter-email" class="sr-only">Email address</label>
		<input
			type="email"
			id="newsletter-email"
			name="email"
			placeholder="Enter your email address"
			required
			autocomplete="email"
		/>
		<input type="hidden" name="embed" value="1" />
		<button type="submit">{buttonText}</button>
	</form>
</div>

<style lang="scss">
	.newsletter-signup {
		margin: 2rem 0;
		padding: 0 1.5rem 0.5rem;
		border: 1px solid var(--nord4);
		border-radius: 8px;

		:global(aside) & {
			padding: 0;
			border: none;
			margin: 0;
		}
	}

	form {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;

		@media (max-width: 600px) {
			flex-direction: column;
			align-items: stretch;
		}

		:global(aside) & {
			flex-direction: column;
			align-items: stretch;
			gap: 0.5rem;
			margin: 0;
			padding: 0;
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	input[type="email"] {
		width: 100%;
		padding: 0.5rem;
		box-sizing: border-box;
		border: 1px solid var(--nord3);
		border-radius: 4px;
		font-size: 1rem;
		background-color: var(--nord1);
		color: var(--nord6);
		transition: border-color 0.2s ease;
		flex: 1;

		&:focus {
			outline: none;
			border-color: var(--nord8);
			box-shadow: 0 0 0 2px rgba(136, 192, 208, 0.2);
		}

		:global(aside) & {
			width: 100%;
		}
	}

	button[type="submit"] {
		background-color: var(--nord10);
		color: var(--nord6);
		padding: 0.5rem 1rem;
		border: none;
		border-radius: 3px;
		cursor: pointer;
		text-decoration: none;
		font-size: 1rem;
		font-weight: 500;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
		white-space: nowrap;

		:global(aside) & {
			width: 100%;
		}

		&:hover {
			cursor: pointer;
			background-color: var(--nord9);
			color: var(--nord1);
		}

		&:active {
			background-color: var(--nord10);
		}

		@media (max-width: 600px) {
			width: 100%;
		}
	}
</style>
