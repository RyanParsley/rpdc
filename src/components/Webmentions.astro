---
import { readFileSync, existsSync } from "fs";
import { join } from "path";
import { WEBMENTION_IO_TOKEN } from "astro:env/server";
import {
	fetchAllVariants,
	computeCounts,
	parseTokenFromEnvFile,
	type WebmentionEntry,
} from "../utils/webmentions";

interface Props {
	target: string;
}
const { target } = Astro.props;

// Load from astro:env first, then fallback to ~/.env
let API_TOKEN = WEBMENTION_IO_TOKEN;

if (!API_TOKEN) {
	const homeEnvPath = process.env.HOME ? join(process.env.HOME, ".env") : null;
	if (homeEnvPath && existsSync(homeEnvPath)) {
		API_TOKEN =
			parseTokenFromEnvFile(readFileSync(homeEnvPath, "utf-8")) ?? undefined;
	}
}

const children = await fetchAllVariants(target, API_TOKEN ?? "");
const counts = computeCounts(children);
const { likesAndRepostsCount, mentionsCount, repliesCount } = counts;
---

{
	children.length > 0 && (
		<div class="webmentions">
			<h3>Webmentions</h3>
			<p>
				{likesAndRepostsCount} likes & reposts,
				{mentionsCount} mentions,
				{repliesCount} replies
			</p>
			<ul class="mentions">
				{children.map((mention: WebmentionEntry) => (
					<li class="mention">
						<div class="author">
							<a href={mention.url} target="_blank" rel="noopener noreferrer">
								{mention.author?.photo && (
									<img src={mention.author.photo} class="author-photo" />
								)}
								{mention.author ? mention.author.name : "Someone"}
							</a>{" "}
							{mention["wm-property"] === "in-reply-to"
								? "replied"
								: mention["wm-property"] === "like-of"
									? "liked"
									: mention["wm-property"] === "repost-of"
										? "reposted"
										: "mentioned"}
						</div>
						{mention.content?.text && (
							<blockquote>{mention.content.text}</blockquote>
						)}
					</li>
				))}
			</ul>
		</div>
	)
}

<style>
	.webmentions {
		margin-top: 2rem;
		border-top: 1px solid var(--nord3);
		padding-top: 1rem;
	}

	.webmentions ul {
		list-style-type: none;
		padding: 0;
	}

	.webmentions li {
		margin-bottom: 1rem;
	}

	.webmentions blockquote {
		margin: 0.5rem 0 0 1rem;
		padding-left: 1rem;
		border-left: 2px solid var(--nord10);
	}

	.mention {
		border: solid 1px var(--nord3);
		padding: 1.5rem;
		border-radius: 0.5rem;
	}

	.author {
		display: flex;
		align-items: center;
		gap: 0.5rem;

		& > a {
			align-items: center;
			display: flex;
		}
	}

	.author-photo {
		height: 3rem;
		width: 3rem;
		border-radius: 1.5rem;
		margin: 0.5rem;
	}
</style>
