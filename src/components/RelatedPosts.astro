---
import { getCollection } from "astro:content";
import {
	selectRelatedPosts,
	type RelatedPostCandidate,
} from "../utils/related-posts";

interface Props {
	slug: string;
	categories?: string[] | undefined;
	tags?: string[] | undefined;
}

const { slug, categories = [], tags = [] } = Astro.props;

const candidates: RelatedPostCandidate[] = (await getCollection("blog")).map(
	(post) => ({
		id: post.id,
		data: {
			title: post.data.title,
			pubDate: post.data.pubDate,
			categories: post.data.categories,
			tags: post.data.tags,
			published: post.data.published,
		},
	}),
);

const posts = selectRelatedPosts(candidates, {
	current: slug,
	categories,
	tags,
});
---

{
	posts.length > 0 && (
		<>
			<h2>Related Posts</h2>
			<ul>
				{posts.map(({ id, title }) => (
					<li>
						<a href={`/blog/${id}`} title={title}>
							{title}
						</a>
					</li>
				))}
			</ul>
		</>
	)
}

<style lang="scss">
	ul {
		margin: 0.75rem 0 0 0;
		padding: 0 0 0 1rem;
	}
	li {
		margin-bottom: 1.5rem;
	}
</style>
