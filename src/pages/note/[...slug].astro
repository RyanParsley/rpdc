---
import { getCollection, render } from "astro:content";
import Post from "@layouts/Post.astro";
import Tags from "@components/Tags.astro";
import Backlinks from "@components/Backlinks.astro";
import { isPublished } from "../../content.config";
const { id: slug } = Astro.props;
const posts = (await getCollection("note")).filter(isPublished);

export async function getStaticPaths() {
	const posts = (await getCollection("note")).filter(isPublished);

	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

const post = Astro.props;
const { Content } = await render(post);

const canonicalURL = new URL(`note/${slug}`, Astro.site)
	.toString()
	.replace(".html", "");
---

<Post
	{...post.data}
	canonicalURL={canonicalURL}
	galleryPath={`/note/${slug}`}
	OGImage={post.data.OGImage}
>
	<Content />
	<Backlinks currentSlug=`/note/${slug}` slot="aside" />
	<Tags
		collection={posts}
		currentTags={post.data.tags}
		baseRoute="note/tag"
		slot="aside"
	/>
</Post>
