---
import { getCollection } from "astro:content";
import Layout from "@layouts/Page.astro";
import { isPublished } from "../../../content.config";

export async function getStaticPaths() {
	const notes = (await getCollection("note")).filter(isPublished);
	const uniqueTags = [
		...new Set(
			notes
				.filter((note) => !!note.data.tags)
				.map((note) => note.data.tags)
				.flat(),
		),
	];

	return uniqueTags.map((tag) => {
		if (tag == undefined) return;

		const filteredNotes = notes.filter((note) => note.data.tags?.includes(tag));

		return {
			params: { tag },
			props: { notes: filteredNotes },
		};
	});
}

const tag = Astro.params?.tag || "?";
const { notes } = Astro.props;
---

<Layout title=`Notes tagged with ${tag}`>
	<ul>
		{
			notes.map((note) => (
				<li>
					<a href={`/note/${note.id}`}>{note.data.title}</a>
				</li>
			))
		}
	</ul>
</Layout>
