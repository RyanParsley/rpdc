---
import Layout from "@layouts/Page.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
---

<Layout
	title="Newsletter"
	description="Get notified when I publish new content."
>
	<section class="newsletter-content">
		<p>
			When something I've written feels worth sharing more broadly, I'll send it
			here. No schedule, but I won't send more than once a week — I don't want
			to litter your inbox.
		</p>

		<NewsletterSignup
			title="Sound good?"
			description=""
			buttonText="Leave your email"
			formClass="form-inline"
		/>

		<p>
			No spam, no selling your address. Unsubscribe anytime if it stops being
			useful.
		</p>

		<p>
			Prefer RSS? <a href="/rss.xml">I support that too</a>.
		</p>
	</section>
</Layout>
