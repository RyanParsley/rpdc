---
import Layout from "@layouts/Page.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
---

<Layout
	title="Newsletter"
	description="Get notified when I publish new content."
>
	<section class="newsletter-content">
		<p>
			I mostly write for myself, but occasionally something lands well enough
			that I want to share it more broadly. If you want to know when that
			happens, you can leave your email here.
		</p>

		<p>
			I don't have a strict schedule. Some months are quiet, others have more to
			say. When something goes out, you'll get it.
		</p>

		<NewsletterSignup title="" description="" buttonText="Leave your email" />

		<p>
			Your email stays with me. No spam, no selling your address, no third-party
			trackers. Unsubscribe anytime.
		</p>

		<p>
			If you prefer RSS, there's a feed <a href="/rss.xml">here</a>.
		</p>
	</section>
</Layout>

<style lang="scss">
	.newsletter-content {
		max-width: 600px;

		h1 {
			font-size: 2rem;
			margin-bottom: 1.5rem;
			color: var(--nord6);
		}

		p {
			font-size: 1.1rem;
			line-height: 1.7;
			color: var(--nord4);
			margin-bottom: 1.5rem;
		}

		a {
			color: var(--nord8);
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}
	}
</style>
