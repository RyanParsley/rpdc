---
import Layout from "@layouts/Page.astro";
import NewsletterSignup from "@components/NewsletterSignup.astro";
---

<Layout
	title="Newsletter"
	description="Get notified when I publish new content."
>
	<section class="newsletter-content">
		<p>
			When something I've written feels worth sharing more broadly, I'll send it
			here. No schedule, no set expectations — just a heads up when there's
			something new.
		</p>

		<NewsletterSignup
			title="Sound good?"
			description=""
			buttonText="Leave your email"
		/>

		<p>
			No spam, no selling your address. Unsubscribe anytime if it stops being
			useful.
		</p>

		<p>
			RSS works too — <a href="/rss.xml">here's the feed</a>.
		</p>
	</section>
</Layout>
