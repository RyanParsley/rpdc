---
import { getCollection } from "astro:content";
import Layout from "@layouts/Page.astro";
import Categories from "@components/Categories.astro";
import { isPublished } from "../../../content.config";

const posts = (await getCollection("blog")).filter(isPublished);
---

<Layout title="Blog (Categories)" description="" shouldShowSearch="true">
	<section>
		<Categories collection={posts} baseRoute="blog/category" />
	</section>
</Layout>
