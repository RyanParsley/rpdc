---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Post from "@layouts/Post.astro";
import RelatedPosts from "@components/RelatedPosts.astro";
import Backlinks from "@components/Backlinks.astro";
import Tags from "@components/Tags.astro";
import { isPublished } from "../../content.config";

const posts = (await getCollection("blog")).filter(isPublished);
type Props = CollectionEntry<"blog">;

export async function getStaticPaths() {
	const posts = (await getCollection("blog")).filter(isPublished);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

const post = Astro.props;
const { id: slug } = Astro.props;
const { Content } = await render(post);
const canonicalURL = new URL(`blog/${slug}`, Astro.site)
	.toString()
	.replace(".html", "");
---

<Post
	{...post.data}
	canonicalURL={canonicalURL}
	galleryPath={`/blog/${slug}`}
	OGImage={post.data.OGImage}
>
	<Content />
	<Backlinks currentSlug=`/blog/${slug}` slot="aside" />
	<Tags
		collection={posts}
		currentTags={post.data.tags}
		baseRoute="blog/tag"
		slot="aside"
	/>
	{
		post.data.categories && (
			<RelatedPosts
				slot="aside"
				categories={post.data.categories}
				tags={post.data.tags}
				slug={post.id}
			/>
		)
	}
</Post>
