---
import Layout from "@layouts/Page.astro";

const { url } = Astro;
const searchParams = url.searchParams;
const status = searchParams.get("status");
const message = searchParams.get("message");
---

<Layout
	title="Newsletter"
	description="Subscribe to my newsletter for the latest posts, updates, and occasional thoughts."
>
	<section class="confirmation-page">
		{
			status === "success" ? (
				<>
					<h1>Thanks for signing up!</h1>
					<p>
						Check your email for a confirmation message. You may need to click
						the confirmation link to complete your subscription.
					</p>
				</>
			) : status === "error" ? (
				<>
					<h1>Something went wrong</h1>
					<p>{message || "There was an error processing your subscription."}</p>
					<p>
						<a href="/">Continue reading →</a>
					</p>
				</>
			) : (
				<>
					<h1>Confirmation Pending</h1>
					<p>Your newsletter subscription is being processed.</p>
				</>
			)
		}
	</section>
</Layout>

<style lang="scss">
	.confirmation-page {
		padding: 2rem 0;

		h1 {
			font-size: 2rem;
			margin-bottom: 1rem;
			color: var(--nord6);
		}

		p {
			color: var(--nord4);
			line-height: 1.6;
			margin-bottom: 1rem;
			font-size: 1.1rem;

			a {
				color: var(--nord8);
				text-decoration: none;

				&:hover {
					text-decoration: underline;
				}
			}
		}
	}
</style>
