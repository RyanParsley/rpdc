---
import Layout from "@layouts/Page.astro";
import SubscribeBlock from "@components/SubscribeBlock.astro";
import ElsewhereBlock from "@components/ElsewhereBlock.astro";

const { url } = Astro;
const searchParams = url.searchParams;
const status = searchParams.get("status");
const message = searchParams.get("message");
---

<Layout
	class="has-aside"
	title="Newsletter"
	description="Subscribe to my newsletter for the latest posts, updates, and occasional thoughts."
>
	<section class="confirmation-page">
		{
			status === "success" ? (
				<>
					<h1>Thanks for signing up!</h1>
					<h2>Pending confirmation</h2>
					<p>
						I deliver email via Buttondown and they'll be sending a confirmation
						to you that you really want these. Please be on the lookout for that
						so you can start receiving the emails.
					</p>
					<p>
						In the meantime, <a href="/">enjoy my backlog</a>.
					</p>
				</>
			) : status === "error" ? (
				<>
					<h1>Something went wrong</h1>
					<p>{message || "There was an error processing your subscription."}</p>
					<p>
						<a href="/">Continue reading →</a>
					</p>
				</>
			) : (
				<>
					<h1>Confirmation Pending</h1>
					<p>Your newsletter subscription is being processed.</p>
				</>
			)
		}
	</section>
	<aside>
		<SubscribeBlock />
		<ElsewhereBlock />
	</aside>
</Layout>

<style lang="scss">
	.confirmation-page {
		padding: 2rem 0;

		h1 {
			font-size: 2rem;
			margin-bottom: 1rem;
			color: var(--nord6);
		}

		h2 {
			font-size: 1.25rem;
			font-weight: normal;
			margin-bottom: 1rem;
			color: var(--nord4);
		}

		p {
			color: var(--nord4);
			line-height: 1.6;
			margin-bottom: 1rem;
			font-size: 1.1rem;

			a {
				color: var(--nord8);
				text-decoration: none;

				&:hover {
					text-decoration: underline;
				}
			}
		}
	}
</style>
