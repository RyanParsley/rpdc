---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "@fontsource/roboto-mono";
import "@fontsource/victor-mono";
const {
	title,
	description,
	class: className,
	url,
	shouldShowSearch,
	image,
	frontmatter,
} = Astro.props;
const isSearchVisible = url == "/404.html" || shouldShowSearch;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<Header />
		<main class={className}>
			<header>
				<h1 class="p-name">{title || frontmatter?.title}</h1>
			</header>
			{
				isSearchVisible && (
					<>
						<PagefindConfig />
						<pagefind-searchbox id="search" class="pagefind-ui" />
					</>
				)
			}
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style lang="scss" is:global>
	.pagefind-ui__drawer {
		background: var(--nord4);
		padding: 0 1rem;
		margin: 0 1rem;
	}
</style>
