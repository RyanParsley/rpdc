{
  "name": "rpdc-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "npx eslint ./src",
    "lint:style": "npx stylelint '**/*.{css,astro}' --fix",
    "format": "prettier **/*.{css,astro,js,mjs,ts,yml,json} --write",
    "postinstall": "npx playwright install chromium",
    "prepare": "husky",
    "postbuild": "pagefind --site dist",
    "new-content": "node scripts/new-content.js",
    "new:ephemera": "npm run new-content -- --type ephemera",
    "new:blog": "npm run new-content -- --type blog",
    "new:note": "npm run new-content -- --type note",
    "pesos": "node scripts/pesos-mastodon.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:typecheck": "vitest run --typecheck",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "!(public/**/*)*.{js,ts,astro}": [
      "eslint --fix"
    ],
    "*.{css,scss,astro}": "stylelint --fix",
    "*.{css,astro,js,mjs,ts,yml,json}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/roboto-mono": "^5.2.9",
    "@fontsource/victor-mono": "^5.2.8",
    "accessible-astro-components": "^5.4.0",
    "astro": "^7.0.7",
    "astro-embed": "^0.13.1",
    "astro-mermaid": "^2.1.0",
    "autoprefixer": "^10.5.2",
    "cssnano": "^8.0.2",
    "marked": "^18.0.6",
    "mermaid": "^11.16.0",
    "photoswipe": "^5.4.4",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/ts-plugin": "^1.10.10",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "astro-pagefind": "^2.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "markdown-it": "^14.3.0",
    "msw": "^2.15.0",
    "playwright": "^1.61.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.0",
    "stylelint-config-astro": "^2.0.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "yaml": "^2.8.3"
  }
}
