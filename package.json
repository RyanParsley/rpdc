{
  "name": "rpdc-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "npx eslint ./src ./scripts",
    "lint:style": "npx stylelint '**/*.{css,astro}' --fix",
    "format": "prettier **/*.{css,astro,js,mjs,ts,yml,json} --write",
    "postinstall": "npx playwright install chromium",
    "prepare": "husky",
    "postbuild": "pagefind --site dist",
    "new-content": "node scripts/new-content.js",
    "new:ephemera": "npm run new-content -- --type ephemera",
    "new:blog": "npm run new-content -- --type blog",
    "new:note": "npm run new-content -- --type note",
    "pesos": "node scripts/pesos-mastodon.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:typecheck": "vitest run --typecheck",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "!(public/**/*)*.{js,ts,astro}": [
      "eslint --fix"
    ],
    "*.{css,scss,astro}": "stylelint --fix",
    "*.{css,astro,js,mjs,ts,yml,json}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/victor-mono": "^5.3.0",
    "accessible-astro-components": "^5.7.1",
    "astro": "^7.2.8",
    "astro-embed": "^0.13.1",
    "astro-mermaid": "^2.1.0",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.10",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "photoswipe": "^5.4.4",
    "sass": "^1.103.1"
  },
  "devDependencies": {
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/ts-plugin": "^1.10.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "astro-pagefind": "^2.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "markdown-it": "^15.0.0",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.1",
    "stylelint-config-astro": "^2.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "stylelint-config-astro": {
      "postcss-html": "^2.0.0"
    }
  }
}
