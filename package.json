{
  "name": "rpdc-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "npx eslint ./src",
    "lint:style": "npx stylelint '**/*.{css,astro}' --fix",
    "format": "prettier **/*.{css,astro,js,ts,yml,json} --write",
    "postinstall": "npx playwright install chromium",
    "prepare": "husky",
    "postbuild": "pagefind --site dist",
    "new-content": "node scripts/new-content.js",
    "new:ephemera": "npm run new-content -- --type ephemera",
    "new:blog": "npm run new-content -- --type blog",
    "new:note": "npm run new-content -- --type note",
    "pesos": "node scripts/pesos-mastodon.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "test:typecheck": "vitest run --typecheck"
  },
  "lint-staged": {
    "!(public/**/*)*.{js,ts,astro}": [
      "eslint --fix"
    ],
    "*.{css,scss,astro}": "stylelint --fix",
    "*.{css,astro,js,ts,yml,json}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/roboto-mono": "^5.2.9",
    "@fontsource/victor-mono": "^5.2.8",
    "accessible-astro-components": "^5.3.1",
    "astro": "^6.4.4",
    "astro-embed": "^0.13.0",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.1",
    "photoswipe": "^5.4.4",
    "sass": "^1.100.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/ts-plugin": "^1.10.9",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.18.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "astro-pagefind": "^2.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "markdown-it": "^14.2.0",
    "msw": "^2.14.6",
    "playwright": "^1.60.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "remark-mermaidjs": "^7.0.0",
    "stylelint": "^17.12.0",
    "stylelint-config-astro": "^2.0.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
