# Buttondown username for newsletter subscription handling
# Used for the public embed form (no API key needed for this)
# Get from: https://buttondown.com/settings/account
BUTTONDOWN_USERNAME=your_buttondown_username

# Buttondown API key (only needed for server-side operations, not for static forms)
# Get from: https://buttondown.com/settings/api
# BUTTONDOWN_API_KEY=your_buttondown_api_key_here